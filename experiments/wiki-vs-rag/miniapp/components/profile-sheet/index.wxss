.layer { position: fixed; z-index: 70; inset: 0; }
.scrim { position: absolute; inset: 0; background: rgba(20,35,43,.38); }
.sheet { position: absolute; inset: auto 0 0; max-height: 82vh; padding: 14rpx 28rpx calc(30rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: var(--color-paper); border-radius: 34rpx 34rpx 0 0; }
.handle { width: 68rpx; height: 8rpx; margin: 0 auto 18rpx; background: #c0c9c6; border-radius: 8rpx; }
.head { display: flex; align-items: flex-start; justify-content: space-between; }
.head > view { display: flex; flex-direction: column; }
.eyebrow { color: var(--color-brand); font-size: 21rpx; font-weight: 650; letter-spacing: .12em; }
.title { margin-top: 5rpx; font-family: "Songti SC", STSong, serif; font-size: 38rpx; font-weight: 650; }
.head button { width: 44px; height: 44px; margin: -8rpx -8rpx 0 0; padding: 0; color: var(--color-muted); background: transparent; font-size: 48rpx; font-weight: 300; }
.identity { margin-top: 22rpx; padding-block: 18rpx; display: flex; justify-content: space-between; color: var(--color-muted); border-block: 1rpx solid var(--color-line); font-size: 23rpx; }
.hero-field { padding: 22rpx 0; display: grid; grid-template-columns: 128rpx 1fr; align-items: center; gap: 10rpx 18rpx; border-bottom: 1rpx solid var(--color-line); }
.hero-field label { font-size: 25rpx; font-weight: 600; }
.hero-field input { min-height: 44px; padding: 0 18rpx; color: var(--color-ink); background: #fff; border: 1rpx solid #b9c6c2; border-radius: 14rpx; font-size: 26rpx; }
.hero-field > text { grid-column: 1 / -1; color: var(--color-muted); font-size: 21rpx; line-height: 1.5; }
.state { min-height: 300rpx; display: flex; align-items: center; justify-content: center; color: var(--color-muted); font-size: 25rpx; }
.state--error { flex-direction: column; gap: 18rpx; color: var(--color-error); text-align: center; }
.state button { min-height: 44px; padding: 0 30rpx; color: var(--color-error); background: #fff; border: 1rpx solid rgba(169,74,63,.35); border-radius: 14rpx; font-size: 24rpx; }
.dimensions { margin-top: 10rpx; }
.dimension { padding: 26rpx 0; border-bottom: 1rpx solid var(--color-line); }
.dimension-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.dimension-head > view { display: flex; flex-direction: column; gap: 4rpx; }
.dimension-title { font-size: 29rpx; font-weight: 650; }
.description { color: var(--color-muted); font-size: 22rpx; line-height: 1.45; }
.confidence { flex: 0 0 auto; color: var(--color-muted); font-size: 21rpx; }
.current { display: block; margin-top: 16rpx; color: var(--color-brand-strong); font-size: 24rpx; font-weight: 600; }
.levels { margin-top: 14rpx; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; }
.levels button { min-height: 44px; margin: 0; color: var(--color-muted); background: #fff; border: 1rpx solid #b9c6c2; border-radius: 14rpx; font-size: 25rpx; }
.levels button.active { color: #fff; background: var(--color-brand); border-color: var(--color-brand); }
.levels button[disabled] { opacity: .55; }
.note { margin-top: 24rpx; padding: 20rpx; display: flex; flex-direction: column; gap: 6rpx; background: var(--color-subtle); border-radius: 16rpx; color: var(--color-muted); font-size: 22rpx; line-height: 1.55; }
.note-title { color: var(--color-ink); font-weight: 600; }
