.banner { margin: 20rpx 24rpx 0; padding: 20rpx 22rpx; display: flex; align-items: center; gap: 18rpx; background: var(--color-warning-soft); border-left: 5rpx solid var(--color-warning); border-radius: 8rpx 18rpx 18rpx 8rpx; }
.banner--error { background: var(--color-error-soft); border-left-color: var(--color-error); }
.copy { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.title { font-size: 27rpx; font-weight: 650; }
.detail { color: var(--color-muted); font-size: 23rpx; line-height: 1.5; }
button { min-width: 48px; min-height: 44px; padding: 0 16rpx; color: var(--color-brand-strong); background: rgba(255,255,255,.74); border: 1rpx solid rgba(20,125,120,.28); border-radius: 14rpx; font-size: 25rpx; font-weight: 600; }
