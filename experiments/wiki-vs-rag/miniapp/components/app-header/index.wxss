.header { position: fixed; inset: 0 0 auto; z-index: 40; background: rgba(247, 247, 245, .96); border-bottom: 1rpx solid rgba(216, 223, 220, .82); }
.bar { height: 96rpx; padding: 0 20rpx; display: grid; grid-template-columns: 88rpx 1fr 88rpx; align-items: center; }
button { margin: 0; padding: 0; background: transparent; color: var(--color-ink); border-radius: 20rpx; }
.icon-button { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; }
.icon-button:active { background: var(--color-subtle); }
.menu-icon { width: 38rpx; display: grid; gap: 7rpx; }
.menu-icon text { display: block; height: 3rpx; background: currentColor; border-radius: 3rpx; }
.menu-icon text:nth-child(2) { width: 28rpx; }
.identity { min-width: 0; min-height: 44px; display: flex; align-items: center; justify-content: center; gap: 16rpx; }
.cookie-mark { width: 54rpx; height: 54rpx; flex: 0 0 auto; border: 3rpx solid var(--color-brand); border-radius: 48%; background: var(--color-brand-soft); transform: rotate(-8deg); position: relative; }
.cookie-mark text { position: absolute; width: 7rpx; height: 7rpx; border-radius: 50%; background: var(--color-brand); }
.cookie-mark text:nth-child(1) { left: 12rpx; top: 13rpx; }
.cookie-mark text:nth-child(2) { right: 11rpx; top: 19rpx; }
.cookie-mark text:nth-child(3) { left: 22rpx; bottom: 10rpx; }
.identity-copy { min-width: 0; text-align: left; display: flex; flex-direction: column; }
.title { font-size: 29rpx; font-weight: 650; letter-spacing: .02em; }
.status-row { display: flex; align-items: center; gap: 8rpx; color: var(--color-muted); font-size: 21rpx; }
.dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #8b9693; }
.dot--ready { background: var(--color-brand); }
.dot--warning { background: #b78321; }
.dot--error { background: var(--color-error); }
.add-button { justify-self: end; font-size: 48rpx; font-weight: 300; line-height: 1; }
