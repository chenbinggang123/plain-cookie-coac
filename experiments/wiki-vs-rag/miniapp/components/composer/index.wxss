.composer { position: fixed; z-index: 35; inset: auto 0 0; padding: 12rpx 22rpx calc(16rpx + env(safe-area-inset-bottom)); background: rgba(247,247,245,.97); border-top: 1rpx solid rgba(216,223,220,.85); }
.level-row { min-height: 58rpx; display: flex; align-items: center; justify-content: space-between; }
.level { min-height: 44px; margin: 0; padding: 0 10rpx; display: flex; align-items: center; gap: 8rpx; color: var(--color-brand-strong); background: transparent; font-size: 23rpx; font-weight: 600; border-radius: 12rpx; }
.spark { font-size: 25rpx; }
.counter { color: var(--color-warning); font-size: 21rpx; }
.counter--error { color: var(--color-error); }
.input-shell { min-height: 52px; padding: 12rpx 12rpx 12rpx 22rpx; display: flex; align-items: flex-end; gap: 12rpx; background: #fff; border: 1rpx solid #bcc8c5; border-radius: 28rpx; }
.input-shell--warning { border-color: var(--color-warning); }
.input { min-height: 56rpx; max-height: 210rpx; flex: 1; padding: 9rpx 0; color: var(--color-ink); font-size: 29rpx; line-height: 1.55; overflow-y: auto; }
.placeholder { color: #87928f; }
.send { width: 44px; height: 44px; min-height: 44px; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; color: #8f9a97; background: var(--color-subtle); border-radius: 50%; font-size: 38rpx; font-weight: 600; line-height: 1; }
.send--ready { color: #fff; background: var(--color-brand); }
.send[disabled] { opacity: .72; }
.spinner { width: 22rpx; height: 22rpx; border: 4rpx solid rgba(255,255,255,.45); border-top-color: #fff; border-radius: 50%; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .spinner { animation: none; border-color: #fff; } }
