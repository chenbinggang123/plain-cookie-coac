# 本地与 CloudBase 共用的模型配置格式。复制为 .env 后填写两个 API Key。
PROVIDER_CONFIG_MODE=environment

# 本地使用 local；CloudBase PostgreSQL 部署改为 cloudbase_pg 并填写连接串。
STORAGE_BACKEND=local
CLOUDBASE_DATABASE_URL=
EMBEDDING_DIMENSIONS=1024
REQUIRE_CLOUDBASE_IDENTITY=false

EMBEDDING_KIND=openai
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_API_KEY=

GENERATION_KIND=openai
GENERATION_BASE_URL=https://api.deepseek.com
GENERATION_MODEL=deepseek-flash
GENERATION_API_KEY=

# 本地留空即可；部署到 CloudBase 时请设置随机长字符串。
INDEX_ADMIN_TOKEN=

# 本地直接读取当前知识库，不需要 GitHub Token；云端部署时再填写。
KNOWLEDGE_GITHUB_TOKEN=
